    "#Standard HistGradientBoostRegressor\n",
    "import time\n",
    "from sklearn.ensemble import HistGradientBoostingRegressor\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score, root_mean_squared_error, mean_absolute_percentage_error\n",
    "from sklearn.preprocessing import OneHotEncoder, OrdinalEncoder\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.compose import ColumnTransformer, TransformedTargetRegressor\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.model_selection import ParameterGrid\n",
    "\n",
    "ohe = OrdinalEncoder(handle_unknown=\"use_encoded_value\",\n",
    "    unknown_value=np.nan,\n",
    "    encoded_missing_value=np.nan,\n",
    "    max_categories=254,)\n",
    "cat_indices = list(range(len(numeric_features), len(numeric_features) + len(categorical_features)))\n",
    "\n",
    "seed = 42\n",
    "\n",
    "def make_forest(loss = \"absolute_error\", learning_rate = 0.1, max_iter= 300, max_leaf_nodes = 31, min_samples_leaf = 5, l2_regularization=0.0,):\n",
    "    prepare = ColumnTransformer([\n",
    "        (\"numeric\", \"passthrough\", numeric_features),\n",
    "        (\"categorical\", ohe, categorical_features),\n",
    "    ])\n",
    "    pipe = Pipeline([\n",
    "        (\"prepare\", prepare),\n",
    "        (\"forest\", HistGradientBoostingRegressor(loss=loss,\n",
    "            learning_rate=learning_rate,\n",
    "            max_iter=max_iter,\n",
    "            max_leaf_nodes=max_leaf_nodes,\n",
    "            min_samples_leaf=min_samples_leaf,\n",
    "            l2_regularization=l2_regularization,\n",
    "            categorical_features=cat_indices,\n",
    "            early_stopping=True,      \n",
    "            validation_fraction=0.1,\n",
    "            n_iter_no_change=15,\n",
    "            random_state=seed,)),\n",
    "         ])\n",
    "    return pipe\n",
    "        \n",
    "#Defining the hyperparameters and running the model:\n",
    "\n",
    "def holdout_table(parameter_choices):\n",
    "    rows, models = [], []\n",
    "    for i, settings in enumerate(ParameterGrid(parameter_choices), start=1):\n",
    "        t0 = time.time()\n",
    "        model = make_forest(**settings).fit(X_train, y_train)\n",
    "        models.append(model)\n",
    "        probs_train = model.predict(X_train)\n",
    "        probs_val = model.predict(X_val)\n",
    "        \n",
    "        predictors = model.named_steps[\"forest\"]._predictors\n",
    "        \n",
    "        rows.append({\n",
    "            \"settings\":settings,\n",
    "            \"training MAE\": mean_absolute_error(y_train, probs_train), #which measure to use?!\n",
    "            \"validation MAE\": mean_absolute_error(y_val, probs_val), #which measure to use?!\n",
    "            \"validation MAE in %\": mean_absolute_percentage_error(y_val, probs_val)*100,\n",
    "            \"training RMSE\": root_mean_squared_error(y_train, probs_train),\n",
    "            \"validation RMSE\": root_mean_squared_error(y_val, probs_val),\n",
    "            \"val_r2\": r2_score(y_val, probs_val),\n",
    "            \"avg_nodes\": sum(p[0].nodes.shape[0] for p in predictors) / len(predictors),\n",
    "        })\n",
    "        print(f\"[{i}/9] Finished {settings} in {time.time() - t0:.1f}s\")\n",
    "    return pd.DataFrame(rows), models\n",
    "\n",
    "depth_results, depth_models = holdout_table({\n",
    "    \"loss\" : [\"absolute_error\"], \"learning_rate\": [0.1], \"max_iter\" : [1000], \"max_leaf_nodes\" : [255], \"min_samples_leaf\" : [20,], \"l2_regularization\": [0.1],\n",
    "})\n",
    "leaf_labels = [str(settings[\"max_leaf_nodes\"]) for settings in depth_results[\"settings\"]]\n",
    "\n",
    "with pd.option_context(\"display.max_rows\", None, \"display.max_columns\", None):\n",
    "    display(depth_results.round(3))\n",
    "\n",
    "\n"
   ]
  },
