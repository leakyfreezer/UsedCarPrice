    "#Splitting the data\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "numeric_features = ['power_ps', 'mileage_km', 'car_age']\n",
    "categorical_features = ['body_type', 'transmission', 'model', 'fuel_type', 'make', 'damaged', ]\n",
    "#data[categorical_features] = data[categorical_features].fillna(\"unknown\")\n",
    "\n",
    "y = data['log_price'].copy()\n",
    "X = data[categorical_features + numeric_features].copy()\n",
    "\n",
    "X_trainval, X_test, y_trainval, y_test = train_test_split(X, y, random_state = 42, test_size = 0.2)\n",
    "X_train, X_val, y_train, y_val = train_test_split(X_trainval, y_trainval, random_state = 42, test_size = 0.2)\n",
    "\n",
    "\n",
    "\n"
   ]
  },
